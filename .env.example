# CodeMind X V2 — environment template.
# Copy to .env and fill in. NEVER commit real secrets (RULES.md §2/§9).
# This file lists NAMES and safe, generic example values only.

# SQLite database location for Prisma (file: URL, relative to the prisma/ dir).
DATABASE_URL="file:../db/custom.db"

# [PLANNED] Explicit CORS allowlist for cross-origin API access (comma-separated
# origins). No wildcard CORS will ever be supported.
# CODEMIND_CORS_ORIGINS=

# [PLANNED] Maximum accepted request body size in bytes
# (server default while unset: 1000000).
# CODEMIND_MAX_UPLOAD_BYTES=1000000
