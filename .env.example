# CodeMind X V2 — environment template.
# Copy to .env and fill in. NEVER commit real secrets (RULES.md §2/§9).
# This file lists NAMES and safe, generic example values only.

# SQLite database location for Prisma (file: URL, relative to the prisma/ dir).
DATABASE_URL="file:../db/custom.db"

# [PLANNED] Explicit CORS allowlist for cross-origin API access (comma-separated
# origins). No wildcard CORS will ever be supported.
# CODEMIND_CORS_ORIGINS=

# [PLANNED] Maximum accepted request body size in bytes
# (server default while unset: 1000000).
# CODEMIND_MAX_UPLOAD_BYTES=1000000

# [PLANNED] Authentication. No provider is configured, so every route stays
# unauthenticated by design (public/local single-user mode; GET /api/auth
# reports mode "unconfigured"). The "local" provider exists as a session-
# lifecycle seam only. NextAuth (v4) integration is [PLANNED].
# CODEMIND_AUTH_PROVIDER=local

# [PLANNED] Session lifetime for created auth sessions, in milliseconds
# (server default while unset: 604800000 = 7 days). Raw tokens are never
# stored — only their SHA-256 hashes.
# CODEMIND_AUTH_SESSION_TTL_MS=604800000

# [PLANNED] NextAuth surface (wired only in the auth phase). NEVER commit a
# real secret; generate NEXTAUTH_SECRET with `openssl rand -base64 32`.
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=

# [PLANNED] OpenTelemetry OTLP collector endpoint. Tracing is LOCAL today:
# real spans are kept in a 500-entry in-memory ring buffer; NO exporter is
# wired, nothing leaves the process.
# CODEMIND_OTEL_EXPORTER_OTLP_ENDPOINT=
