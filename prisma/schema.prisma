// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// PHASE 3 — DOMAIN MODELS (CodeMind X V2.1, spec sections 2 + 3)
//
// Conventions binding for every model below:
// - SQLite has NO native enum or JSON types. Every "enum-like" field is a
//   `String` whose allowed values are documented in a comment on the field;
//   runtime validation (zod) is enforced by later phases that write these
//   tables. JSON payloads are stored as JSON text in String columns.
// - Every model: `id` uuid PK, `createdAt` (default now), `updatedAt` (auto).
// - Deletion rules: owned children use `onDelete: Cascade`; optional
//   references use `onDelete: SetNull` (FK column is therefore nullable).
// - Public identifier (`publicId String @unique @default(uuid())`) exists on
//   models that external surfaces (API, URLs) may reference:
//   analysis_jobs, chat_sessions, agent_runs, change_sets. Repository's
//   public identifier is its unique human-readable `slug`.
// - No foreign keys to User: relations to the legacy User model are deferred
//   until the auth phase (spec allows safe additive evolution). No
//   back-relations were added to the legacy User/Post models.
// - Embedding vectors are [PLANNED] — nothing in this schema stores vectors.
// ============================================================================

/// A connected code repository.
model Repository {
  id            String   @id @default(uuid())
  name          String
  /// Unique, URL-safe public identifier (also serves as the slug index).
  slug          String   @unique
  description   String?
  defaultBranch String?
  /// "connected" | "indexing" | "unavailable"
  status        String
  /// Workspace-relative root for the canonical workspace ("."). For IMPORTED
  /// repositories (Phase 4): the absolute path of the isolated checkout under
  /// the ingestion workspace root. Never contains credentials.
  sourcePath    String?
  /// PHASE 4 import provenance. "workspace" | "github" | "git" | "zip" | "local"
  sourceKind    String   @default("workspace")
  /// Sanitized source URL (credentials stripped) — null for workspace/zip.
  sourceUrl     String?
  /// Branch/tag/commit the import checked out.
  sourceRef     String?
  /// HEAD sha captured at import time (honest null when unavailable).
  clonedSha     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branches         RepositoryBranch[]
  files            RepositoryFile[]
  symbols          RepositorySymbol[]
  chunks           RepositoryChunk[]
  jobs             AnalysisJob[]
  chatSessions     ChatSession[]
  agentRuns        AgentRun[]
  securityFindings SecurityFinding[]
  generatedTests   GeneratedTest[]
  documents        Document[]
  commits          GitCommit[]
  gitBranches      GitBranch[]
  evaluations      Evaluation[]
  codeChanges      CodeChange[]
  changeSets       ChangeSet[]
  members          RepositoryMember[]
  memoryItems      MemoryItem[]
  glossaryEntries  GlossaryEntry[]
  decisionRecords  DecisionRecord[]
  auditLogs        AuditLog[]
  snapshots        RepositoryIndexSnapshot[]
  findings         RepositoryImportFinding[]

  @@index([status])
  @@map("repositories")
}

/// Branch cache populated by indexing (live git state is mirrored in GitBranch).
model RepositoryBranch {
  id           String   @id @default(uuid())
  repositoryId String
  name         String
  headSha      String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
  @@map("repository_branches")
}

/// A file (or directory row) tracked by the indexer.
model RepositoryFile {
  id             String    @id @default(uuid())
  repositoryId   String
  path           String
  isDir          Boolean   @default(false)
  size           Int       @default(0)
  language       String?
  /// PHASE 5: sha256 hex of the file bytes at index time (null when the file
  /// could not be read — never fabricated). Provenance chain:
  /// repository → snapshot (ref/commit) → file (path + hash).
  contentHash    String?
  lastIndexedAt  DateTime?
  /// PHASE 5: index run that produced this row. SetNull on snapshot delete.
  snapshotId     String?
  /// PHASE 5 trust classification (informational, NEVER authoritative):
  /// "repository_data" | "repository_documentation" | "repository_comment" |
  /// "repository_fixture" | "repository_generated_output" | null
  /// (null = ordinary source code — unclassified, not flagged).
  classification String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  repository Repository               @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  snapshot   RepositoryIndexSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  symbols    RepositorySymbol[]
  chunks     RepositoryChunk[]

  @@unique([repositoryId, path])
  @@index([repositoryId, isDir])
  @@index([snapshotId])
  @@map("repository_files")
}

/// A code symbol extracted by indexing.
model RepositorySymbol {
  id           String   @id @default(uuid())
  repositoryId String
  fileId       String?
  name         String
  /// "function" | "class" | "method" | "variable" | "type" | "other"
  kind         String
  path         String
  line         Int
  endLine      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  file       RepositoryFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([repositoryId, kind])
  @@index([fileId])
  @@map("repository_symbols")
}

/// A retrieval chunk used by the search engine.
model RepositoryChunk {
  id              String   @id @default(uuid())
  repositoryId    String
  fileId          String
  ordinal         Int
  /// Retrieval text — populated only when indexing writes it; embedding
  /// vectors are [PLANNED] (this schema stores no vectors).
  content         String?
  /// "none" | "pending" | "embedded"
  embeddingStatus String   @default("none")
  tokens          Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  repository Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  file       RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId, ordinal])
  @@index([repositoryId])
  @@map("repository_chunks")
}

/// A unit of analysis/indexing work. `type` is registry-validated in later
/// phases (e.g. "repository.index" | "analysis.full").
model AnalysisJob {
  id           String    @id @default(uuid())
  publicId     String    @unique @default(uuid())
  repositoryId String?
  type         String
  /// QUEUED | RUNNING | PAUSED | CANCELLED | COMPLETED | FAILED
  status       String    @default("QUEUED")
  stage        String?
  /// Completion progress; semantics defined by the job runner in later phases.
  progress     Float     @default(0)
  /// Opaque JSON checkpoint text written by the job runner.
  checkpoint   String?
  /// JSON request payload the job was created from — credentials/tokens are
  /// stripped before persistence (Phase 4 import jobs).
  input        String?
  attempts     Int       @default(0)
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?
  /// Liveness timestamp updated by the runner while the job is RUNNING.
  heartbeatAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  repository  Repository?          @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  checkpoints AnalysisCheckpoint[]
  activities  Activity[]
  approvals   Approval[]

  @@index([status])
  @@index([repositoryId, status])
  @@index([type, status])
  @@map("analysis_jobs")
}

/// Resumable-state checkpoint for an AnalysisJob. `payload` is JSON text.
model AnalysisCheckpoint {
  id        String   @id @default(uuid())
  jobId     String
  key       String
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, key])
  @@index([jobId])
  @@map("analysis_checkpoints")
}

/// A persisted chat conversation. `publicId` is the external identifier.
model ChatSession {
  id            String    @id @default(uuid())
  publicId      String    @unique @default(uuid())
  repositoryId  String?
  title         String?
  /// "active" | "archived" | "deleted"
  status        String    @default("active")
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  repository   Repository?   @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]
  agentRuns    AgentRun[]
  usageRecords UsageRecord[]

  @@index([repositoryId])
  @@index([status])
  @@map("chat_sessions")
}

/// One message in a ChatSession. `content` maps to TEXT in SQLite.
model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  /// "user" | "assistant" | "system"
  role      String
  content   String
  /// "complete" | "generating" | "error" | "stopped"
  state     String   @default("complete")
  error     String?
  tokens    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

/// An orchestrated agent execution. `publicId` is the external identifier.
model AgentRun {
  id           String    @id @default(uuid())
  publicId     String    @unique @default(uuid())
  sessionId    String?
  repositoryId String?
  /// "assistant" | "analysis" | "coding" | "testing" | "review" | "orchestrator" | "custom"
  kind         String
  /// "queued" | "running" | "waiting-approval" | "applying" | "verifying" | "validating" | "completed" | "failed" | "cancelled"
  status       String    @default("queued")
  input        String?
  output       String?
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  session         ChatSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  repository      Repository?      @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  activities      Activity[]
  approvals       Approval[]
  evaluations     Evaluation[]
  codeChanges          CodeChange[]
  changeSets           ChangeSet[]
  decisionRecords      DecisionRecord[]
  usageRecords         UsageRecord[]
  orchestratorSpans    OrchestratorAgentSpan[]

  @@index([status])
  @@index([sessionId])
  @@index([repositoryId])
  @@map("agent_runs")
}

/// A user-visible activity step performed by a run or job.
/// Privacy contract (ARCHITECTURE.md §8): `label` is a short operational
/// string only. Model reasoning is NEVER stored here.
model Activity {
  id        String    @id @default(uuid())
  runId     String?
  jobId     String?
  /// Closed vocabulary aligned with ActivityKind in src/types/contracts.ts:
  /// "understanding" | "search" | "read" | "plan" | "code" | "test" |
  /// "security" | "git" | "architecture" | "finalize"
  kind      String
  /// Short operational label — never model reasoning (privacy contract).
  label     String
  /// "pending" | "active" | "done" | "error"
  status    String    @default("pending")
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  run AgentRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  job AnalysisJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([jobId])
  @@map("activities")
}

/// One agent span inside an orchestrator run (Phase 9 observability §8).
/// Stores run metadata ONLY (agent id, status, duration, tool count, errors)
/// — never model reasoning, tokens, credentials or private file content.
model OrchestratorAgentSpan {
  id            String    @id @default(uuid())
  runId         String?
  /// Agent contract name ("planner" | "retrieval" | "code-analyst" | …).
  agentName     String
  agentVersion  String
  /// "running" | "completed" | "failed" | "timeout" | "skipped" |
  /// "cancelled" | "awaiting-approval"
  status        String    @default("running")
  /// Ordered execution wave (0 = first stage). Independent agents in the
  /// same wave ran in parallel.
  wave          Int       @default(0)
  attempts      Int       @default(1)
  toolCount     Int       @default(0)
  findingsCount Int       @default(0)
  /// "high" | "probable" | "weak" — honest tier, null when not assessed.
  confidence    String?
  /// JSON array of source paths (evidence locations), no content.
  sourcesJson   String?
  error         String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  run AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([agentName, status])
  @@map("orchestrator_agent_spans")
}

/// A human-in-the-loop approval request raised by a run or job.
model Approval {
  id           String    @id @default(uuid())
  runId        String?
  jobId        String?
  /// "file-write" | "command" | "git-write" | "external" | "other"
  kind         String
  /// "pending" | "approved" | "rejected" | "expired"
  status       String    @default("pending")
  /// JSON payload describing exactly what is being approved.
  payload      String?
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  run AgentRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  job AnalysisJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([runId])
  @@index([jobId])
  @@map("approvals")
}

/// A finding produced by the security scanner.
model SecurityFinding {
  id           String   @id @default(uuid())
  repositoryId String
  /// "critical" | "high" | "medium" | "low" | "info"
  severity     String
  ruleId       String
  path         String?
  line         Int?
  message      String
  /// "open" | "resolved" | "dismissed"
  status       String   @default("open")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, severity])
  @@index([status])
  @@map("security_findings")
}

/// A test generated by the testing engine.
model GeneratedTest {
  id           String   @id @default(uuid())
  repositoryId String
  /// Test file path.
  path         String
  /// Path of the code under test.
  targetPath   String?
  framework    String?
  /// "draft" | "generated" | "passed" | "failed" | "outdated"
  status       String   @default("draft")
  content      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, status])
  @@map("generated_tests")
}

/// A document produced or indexed for a repository.
model Document {
  id           String   @id @default(uuid())
  repositoryId String?
  /// "readme" | "design" | "api" | "runbook" | "other"
  kind         String
  path         String?
  title        String
  content      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@index([repositoryId, kind])
  @@map("documents")
}

/// A commit mirrored from the repository's git history.
model GitCommit {
  id           String    @id @default(uuid())
  repositoryId String
  sha          String
  message      String
  authorName   String?
  authorEmail  String?
  committedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, sha])
  @@index([repositoryId, committedAt])
  @@map("git_commits")
}

/// A branch mirrored from live git state (indexing-side cache: RepositoryBranch).
model GitBranch {
  id           String   @id @default(uuid())
  repositoryId String
  name         String
  headSha      String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
  @@map("git_branches")
}

/// A quality evaluation of a run or repository.
model Evaluation {
  id           String   @id @default(uuid())
  repositoryId String?
  runId        String?
  /// "assistant-quality" | "test-pass" | "regression" | "other"
  kind         String
  score        Float?
  summary      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  run        AgentRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([repositoryId, kind])
  @@index([runId])
  @@map("evaluations")
}

/// A proposed/applied file-level change produced by an agent run.
model CodeChange {
  id           String   @id @default(uuid())
  repositoryId String?
  runId        String?
  changeSetId  String?
  path         String
  /// "add" | "modify" | "delete"
  changeKind   String
  /// "proposed" | "applied" | "reverted"
  status       String   @default("proposed")
  diff         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  run        AgentRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  changeSet  ChangeSet?  @relation(fields: [changeSetId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([repositoryId, status])
  @@index([changeSetId])
  @@map("code_changes")
}

/// A reviewable group of code changes. `publicId` is the external identifier.
model ChangeSet {
  id           String   @id @default(uuid())
  publicId     String   @unique @default(uuid())
  repositoryId String?
  runId        String?
  title        String
  /// "draft" | "proposed" | "applied" | "discarded"
  status       String   @default("draft")
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository?  @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  run        AgentRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  changes    CodeChange[]

  @@index([repositoryId, status])
  @@index([runId])
  @@map("change_sets")
}

// ============================================================================
// V2.1 ADDITIONS (Phase 4 session) — AUTH, MEMORY, USAGE, AUDIT
//
// Same conventions as the Phase 3 block above: SQLite String "enums" are
// documented vocabularies validated by writers, uuid PKs, createdAt/updatedAt
// everywhere, Cascade for owned children, SetNull for optional refs.
// Still NO foreign keys to the legacy User model — auth identity linkage
// happens through `subject` strings (provider identity ids), so the legacy
// baseline remains untouched.
// ============================================================================

/// A provider-backed authentication session (V2.1 §A — auth foundation).
/// `tokenHash` stores a SHA-256 hash of the session token — never the token.
model AuthSession {
  id         String    @id @default(uuid())
  publicId   String    @unique @default(uuid())
  /// Opaque session token hash (hex). The raw token NEVER reaches the DB.
  tokenHash  String    @unique
  /// "local" | "github" | "google" | … (provider abstraction registry)
  provider   String
  /// Provider-stable subject id (e.g. GitHub user id as string).
  subject    String
  /// Application-level user id (legacy User linkage deferred — plain string).
  userId     String?
  /// "active" | "expired" | "revoked"
  status     String    @default("active")
  expiresAt  DateTime
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([subject])
  @@index([status])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Repository-level authorization grant (V2.1 §A). Role vocabulary:
/// "owner" | "maintainer" | "writer" | "reader". Backend checks are the
/// source of truth — frontend checks are never trusted.
model RepositoryMember {
  id           String   @id @default(uuid())
  repositoryId String
  /// Provider-stable subject id of the member.
  subject      String
  /// "owner" | "maintainer" | "writer" | "reader"
  role         String   @default("reader")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, subject])
  @@index([subject])
  @@map("repository_members")
}

/// A durable memory entry (V2.1 §C — memory schema reservation;
/// Phase 9.5 Adaptive Memory Engine extends it additively).
/// Phase 9.5 field vocabularies (SQLite String "enums", validated by
/// src/server/memory/types.ts at every write):
/// - scope:  "global" | "repository" | "user" | "session" (baseline)
///           | "path" | "language" | "team" (Phase 9.5 additions)
/// - type:   "fact" | "preference" | "summary" | "decision" | "other" (baseline)
///           | "project-rule" | "concept" | "correction" (Phase 9.5 — the
///           five memory layers map to project-rule/decision/concept/
///           preference/correction)
/// - status: "active" | "superseded" | "archived" | "deleted" (baseline)
///           | "proposed" | "disabled" (Phase 9.5 — proposed = Memory Inbox
///           candidate, never active without explicit confirmation;
///           disabled = kept but never retrieved)
/// SECURITY (Phase 9.5 §15): rows are ONLY created through paths whose
/// origin is user-authored (manual form, user chat message, CODEMIND.md
/// sync, inbox accept). README/comment/tool-output/log/commit-message text
/// can NEVER become a memory, and secrets are rejected before insert.
model MemoryItem {
  id           String    @id @default(uuid())
  /// scope vocabulary above.
  scope        String
  /// Subject reference within the scope (repo id / subject id / session id /
  /// path prefix / language id / team id).
  scopeRef     String?
  repositoryId String?
  /// type vocabulary above.
  type         String
  /// status vocabulary above.
  status       String    @default("active")
  /// Phase 9.5 — "explicit" (user- or CODEMIND.md-authored) | "inferred"
  /// (engine-proposed; requires inbox confirmation before activation).
  source       String    @default("explicit")
  /// Phase 9.5 — honest 0..1 confidence (proposals carry their real match
  /// strength; explicit user saves default to 1).
  confidence   Float     @default(0.5)
  /// Phase 9.5 — JSON array of real evidence refs ("src/auth.ts:42",
  /// "CODEMIND.md#3"). Never fabricated; empty for pure preference notes.
  evidenceRefsJson String?
  /// Phase 9.5 — optional expiry; null = never expires. Expired items are
  /// excluded from retrieval (not deleted — the user decides that).
  expiresAt    DateTime?
  /// Phase 9.5 — provenance guard (enforced in code, audited in AuditLog):
  /// "manual" | "user-message" | "codemind-md" | "inbox-accept".
  origin       String    @default("manual")
  title        String
  content      String
  importance   Float     @default(0.5)
  useCount     Int       @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  repository Repository?   @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  events     MemoryEvent[]

  @@index([scope])
  @@index([type])
  @@index([status])
  @@index([lastUsedAt])
  @@index([repositoryId])
  @@map("memory_items")
}

/// Append-only lifecycle event for a memory item.
model MemoryEvent {
  id        String   @id @default(uuid())
  itemId    String
  /// "created" | "updated" | "recalled" | "superseded" | "archived" |
  /// "deleted" (baseline) | "proposed" | "accepted" | "rejected" |
  /// "disabled" | "enabled" | "drift-reviewed" (Phase 9.5 additions)
  eventType String
  detail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item MemoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@map("memory_events")
}

/// A user profile reserved for personalization (V2.1 §C).
model UserProfile {
  id          String   @id @default(uuid())
  /// Provider-stable subject id — the profile's stable external key.
  subject     String   @unique
  displayName String?
  timezone    String?
  locale      String?
  /// JSON preferences text (never credentials).
  prefsJson   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([subject])
  @@map("user_profiles")
}

/// A project glossary entry (V2.1 §C).
model GlossaryEntry {
  id           String   @id @default(uuid())
  repositoryId String?
  term         String
  definition   String
  /// JSON array-of-strings text (SQLite has no list primitive).
  aliasesJson  String?
  /// "active" | "deprecated"
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@unique([repositoryId, term])
  @@index([repositoryId])
  @@index([status])
  @@map("glossary")
}

/// An architecture/implementation decision record (V2.1 §C).
model DecisionRecord {
  id               String    @id @default(uuid())
  repositoryId     String?
  runId            String?
  title            String
  decision         String
  rationale        String?
  /// JSON array-of-strings text (alternatives considered).
  alternativesJson String?
  /// "proposed" | "accepted" | "superseded" | "rejected"
  status           String    @default("proposed")
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  run        AgentRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([repositoryId])
  @@index([status])
  @@map("decision_records")
}

/// Generic provider cost/usage accounting row (V2.1 §D) — Phase 3.5 fills
/// these from real gateway calls. `estimatedCost` is provider-native units
/// unless a pricing table exists later; never fabricated.
model UsageRecord {
  id            String   @id @default(uuid())
  requestId     String?
  sessionId     String?
  runId         String?
  jobId         String?
  /// e.g. "zai" | "openai" | "anthropic" (gateway vocabulary)
  provider      String
  model         String
  inputTokens   Int?
  outputTokens  Int?
  estimatedCost Float?
  latencyMs     Int?
  /// "none" | "hit" | "miss" | "write" | "unknown"
  cacheStatus   String   @default("unknown")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  run     AgentRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([provider, model])
  @@index([sessionId])
  @@index([createdAt])
  @@map("usage_records")
}

/// Append-only audit trail for consequential events (V2.1 §E).
/// `metadata` is JSON text and must NEVER contain secrets or credentials.
model AuditLog {
  id           String   @id @default(uuid())
  /// "user" | "system" | "agent" | "service"
  actorType    String   @default("system")
  actorId      String?
  /// Closed vocabulary: "login" | "repository.access" | "repository.import" |
  /// "approval.granted" | "approval.rejected" | "git.mutation" |
  /// "memory.change" | "agent.autonomy.change" | "mcp.tool.invocation" | "other"
  action       String
  targetType   String?
  targetId     String?
  repositoryId String?
  requestId    String?
  metadata     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorId])
  @@index([repositoryId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// PHASE 4 — REPOSITORY IMPORT (additive columns on existing tables)
// ============================================================================

/// Resumable import job input. JSON text; NEVER contains credentials/tokens.
// (AnalysisJob.input — added to the model above.)

// ============================================================================
// PHASE 5 — V2.1 TRUST METADATA (provenance snapshots + import findings)
//
// Conventions carried over from Phase 3 (see the block above): SQLite has no
// enum/JSON types — enum-like fields are commented Strings; deletion rules are
// Cascade for owned children, SetNull for optional references.
// NOTE: these two tables use cuid() ids per the Phase 5 spec (older tables use
// uuid()); they are append-only fact rows without updatedAt by design.
// ============================================================================

/// One indexing run over a repository. Anchors the provenance chain:
/// repository (repositoryId) → ref/commit at index time (ref/commitSha) →
/// per-file rows (RepositoryFile.snapshotId). parentSnapshotId enables
/// lineage between runs ("full" today; "incremental" reserved for later).
model RepositoryIndexSnapshot {
  id                   String   @id @default(cuid())
  repositoryId         String
  /// Snapshot this run derives from (SetNull when the parent is deleted).
  parentSnapshotId     String?
  /// Branch/tag/ref string at index time (honest null when unknown).
  ref                  String?
  /// HEAD sha at index time (honest null when unknown).
  commitSha            String?
  /// "full" | "incremental"
  kind                 String   @default("full")
  /// Pipeline versions in force for this run (see index-metadata.ts).
  parserVersion        String
  chunkingVersion      String
  embeddingVersion     String
  /// Hash algorithm used for RepositoryFile.contentHash.
  contentHashAlgorithm String   @default("sha256")
  /// REAL count of files written under this snapshot (updated at completion).
  filesIndexed         Int      @default(0)
  createdAt            DateTime @default(now())

  repository Repository                @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  parent     RepositoryIndexSnapshot?  @relation("SnapshotLineage", fields: [parentSnapshotId], references: [id], onDelete: SetNull)
  children   RepositoryIndexSnapshot[] @relation("SnapshotLineage")
  files      RepositoryFile[]

  @@index([repositoryId, createdAt])
  @@map("repository_index_snapshots")
}

/// Import/index findings — honest observations, never a failure by itself
/// (skipped symlinks, refused archive entries, unsafe paths). Append-only;
/// prior rows for the same (repositoryId, jobId) are deleted before a re-run
/// re-inserts (idempotent per job).
model RepositoryImportFinding {
  id           String   @id @default(cuid())
  repositoryId String?
  /// AnalysisJob that observed the finding (publicId is stored by writers).
  jobId        String?
  /// "symlink" | "zip_rejected_entry" | "unsafe_path" | "oversized"
  kind         String
  /// Repo-relative path or zip entry name the finding refers to.
  detailPath   String
  note         String?
  createdAt    DateTime @default(now())

  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, kind])
  @@index([jobId])
  @@map("repository_import_findings")
}

// ============================================================================
// OCR STUDIO — real image text extraction (vision model), append-only history
// ============================================================================

/// One OCR extraction run. Text is produced by the vision model — every
/// stored field is measured truth (duration, sizes, counts), never fabricated.
model OcrJob {
  id        String   @id @default(cuid())
  /// Original upload filename (sanitized, display only).
  filename  String
  /// "image/png" | "image/jpeg" | "image/webp" | "image/gif" | "image/bmp"
  mimeType  String
  /// Uploaded image size in bytes (after server-side normalization).
  sizeBytes Int
  /// Extraction mode: "plain" | "layout" | "code" | "table" | "ask"
  mode      String   @default("plain")
  /// Custom question when mode === "ask" (empty otherwise).
  question  String?
  /// "processing" | "completed" | "failed"
  status    String   @default("processing")
  /// Extracted text (verbatim when the model can read it).
  text      String?
  /// Free-form honest note when status === "failed" (safe message only).
  error     String?
  /// Wall-clock duration of the vision call in ms (measured).
  durationMs Int?
  /// Model-reported primary text language (e.g. "English"), null when unknown.
  language  String?
  /// Measured word count of `text` (0 when empty).
  wordCount Int      @default(0)
  /// Measured character count of `text` (0 when empty).
  charCount Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("ocr_jobs")
}
